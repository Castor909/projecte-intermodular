# Server port
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/vinyleth

# JWT secret — change this before any real deployment
JWT_SECRET=change_me_in_production

# Admin panel password
ADMIN_PASSWORD=admin123

# Resend API key — get yours free at resend.com
# Required for order receipt emails; leave blank to disable emails
RESEND_API_KEY=

# Email address that receives receipts on Resend free plan
# (free plan ignores the customer's email and sends here instead)
RECEIPT_EMAIL=

# Discogs API token — get yours free at discogs.com/settings/developers
# Required for the Quick Import feature in the admin panel
DISCOGS_TOKEN=
